{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bob baixa",
  "mainBinaryName": "bob-baixa",
  "version": "0.4.0",
  "identifier": "com.bobbaixa.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "bob baixa",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data: https://i.ytimg.com https://*.ytimg.com https://*.ggpht.com https://*.googleusercontent.com",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* https:",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob: data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$APPLOCALDATA/**", "$APPDATA/**", "$LOCALDATA/**", "$TEMP/**", "$DOWNLOAD/**", "$VIDEO/**", "$HOME/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/extension/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "bob baixa",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bobbaixa"]
      }
    }
  }
}
